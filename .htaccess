# =====================================================================
# Helpdesk IT Support — pengerasan web server (Apache 2.4)
# =====================================================================

# --- Jangan pernah tampilkan daftar isi direktori ---
Options -Indexes

# --- Sembunyikan versi PHP dari header respons ---
<IfModule mod_headers.c>
    Header always unset X-Powered-By
    Header unset X-Powered-By
</IfModule>

# --- Blokir semua berkas titik (.env, .gitignore, .htpasswd, dll) ---
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# --- Blokir berkas konfigurasi, dokumentasi internal, dan skrip non-web ---
<FilesMatch "(?i)\.(env|env\.example|ini|log|sql|md|json|lock|bak|old|orig|save|swp|dist|yml|yaml|sh|bat|ps1)$">
    Require all denied
</FilesMatch>

# --- Blokir direktori internal beserta seluruh isinya ---
# Hanya index.php dan folder assets/ + uploads/ yang boleh diakses browser.
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Direktori kode & data internal
    RewriteRule ^(app|database|storage)(/|$) - [F,L]

    # Direktori dan berkas metadata git
    RewriteRule ^\.git(/|$) - [F,L]
</IfModule>

# --- Cegah akses langsung ke berkas PHP internal (fallback tanpa mod_rewrite) ---
<IfModule !mod_rewrite.c>
    <FilesMatch "(?i)\.(php|phtml)$">
        Require all denied
    </FilesMatch>
    <Files "index.php">
        Require all granted
    </Files>
</IfModule>

# --- Batasi metode HTTP yang diterima ---
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_METHOD} !^(GET|HEAD|POST)$
    RewriteRule .* - [F,L]
</IfModule>
